# PingClose Environment Variables
# Copy this file to .env.local and fill in your real values.
# Every "your_x_here" placeholder below WILL fail silently or with a
# confusing error if left unfilled — Next.js doesn't warn you, the affected
# feature just breaks in a way that looks like a real bug. Check this file
# first before debugging why something that touches an external API isn't
# working.

# Supabase — same project as LocalSEOAEOPro
# Get from: Supabase dashboard (supabase.com/dashboard) → project
# xvrhxtnhmnurvxitnijy → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xvrhxtnhmnurvxitnijy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google PageSpeed Insights API — used by lib/agents/pagespeedAgent, powers
# every audit's real LCP/FCP/TTFB/mobile-desktop scores.
# Get from: console.cloud.google.com/apis/credentials — enable "PageSpeed
# Insights API" on a project first (Library → search "PageSpeed Insights"
# → Enable), then Credentials → Create credentials → API key. Restrict the
# key to "PageSpeed Insights API" only (Select API restrictions dropdown).
# Application restrictions can stay "None" — this key can't do anything but
# read-only speed tests even if it leaks, and IP-restricting it tends to
# just break local dev on a non-static IP.
# Production's real key lives in Vercel env vars, not here — this is only
# for local dev / direct diagnostic calls from this machine.
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Resend Email — get from: resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=jim@pingclose.com
NOTIFY_EMAIL=james.fogal@gmail.com

# Admin — ADMIN_PASSWORD is just a password you choose yourself, not from
# an external service. ADMIN_TOTP_SECRET is the base32 secret your
# authenticator app (Google Authenticator, Authy, etc.) was given when you
# first set up 2FA for /admin — if you don't still have it, you'll need to
# re-enroll a new secret and update your authenticator app to match.
ADMIN_PASSWORD=your_admin_password_here
ADMIN_TOTP_SECRET=your_totp_secret_here

# Internal server-to-server auth (e.g. /api/dataforseo-keywords) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=your_internal_secret_here

# Site URL
NEXT_PUBLIC_SITE_URL=https://pingclose.com

# NEVER paste a real value from any of the above into a chat, screenshot, or
# shared doc — including to Claude. Type real values directly into
# .env.local yourself (this .example file is committed to git; .env.local
# is not). If Claude needs a key for diagnostics, edit .env.local yourself
# and just say "done" — the value never needs to be typed anywhere else.
